# ---------------------------------------------------------------------------
# omniroute-gateway — copy to .env and fill in whatever you have.
# Every provider is optional: a provider with no key is simply not registered.
# ---------------------------------------------------------------------------

# --- Gateway ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated list of keys clients must send as `Authorization: Bearer <key>`.
# Leave empty to run open (allowed only when bound to localhost).
GATEWAY_API_KEYS=

# Path to an optional JSON config file (providers, routes, policy).
# See config/gateway.example.json.
GATEWAY_CONFIG=

# Per-attempt upstream timeout in milliseconds.
REQUEST_TIMEOUT_MS=120000
# How long to wait for the first streamed token before giving up on a provider.
STREAM_FIRST_TOKEN_TIMEOUT_MS=30000
# Maximum number of providers tried for a single request.
MAX_ATTEMPTS=3

# --- Provider keys ---------------------------------------------------------
# Hosted providers with a free tier are marked FREE.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=                 # FREE tier
GOOGLE_API_KEY=               # FREE tier (Gemini, OpenAI-compatible endpoint)
CEREBRAS_API_KEY=             # FREE tier
OPENROUTER_API_KEY=           # FREE models available (`:free` suffix)
GITHUB_MODELS_TOKEN=          # FREE tier (a GitHub PAT)
MISTRAL_API_KEY=              # FREE tier
NVIDIA_API_KEY=               # FREE tier
SCALEWAY_API_KEY=             # FREE tier
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
HYPERBOLIC_API_KEY=
NEBIUS_API_KEY=
SAMBANOVA_API_KEY=
NOVITA_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=            # Alibaba Qwen
AI21_API_KEY=
VOYAGE_API_KEY=

# --- Local runtimes --------------------------------------------------------
# These need no API key; set the *_ENABLED flag to register them.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_ENABLED=false
LLAMACPP_BASE_URL=http://localhost:8080/v1
VLLM_ENABLED=false
VLLM_BASE_URL=http://localhost:8000/v1

{
  "name": "omniroute-gateway",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted AI gateway: one OpenAI-compatible endpoint, many providers, automatic fallback.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "omniroute": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
